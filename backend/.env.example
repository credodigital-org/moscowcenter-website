# =============================================================================
# Moscow Centre backend — copy to `.env` for local work. NEVER commit `.env`.
# On Render, enter these in the service's Environment tab instead.
# =============================================================================

# --- Local development (works with no other settings: SQLite + media/ folder) -
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# =============================================================================
# PRODUCTION (Render) — set all of these
# =============================================================================

# DJANGO_DEBUG=False
# DJANGO_SECRET_KEY=<long random string — Render can generate one>

# Hosts and origins. Render's own hostname is added automatically.
# DJANGO_ALLOWED_HOSTS=api.your-domain.com
# DJANGO_CORS_ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://api.your-domain.com

# Neon PostgreSQL connection string
# DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/moscow_center?sslmode=require

# Cloudflare R2 — every uploaded photo and video (all five are required)
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=moscow-center-media
# R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# R2_PUBLIC_BASE_URL=https://media.your-domain.com

# Optional: email the clinic when someone sends an appointment request.
# (Requests are always saved and shown in Admin → Enquiries, with or without this.)
# EMAIL_HOST=smtp.your-provider.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=Moscow Centre <noreply@your-domain.com>
# ENQUIRY_NOTIFY_EMAILS=reception@your-domain.com,manager@your-domain.com

# Optional: change the form rate limit (default 20 submissions per visitor per hour)
# DJANGO_ENQUIRY_RATE=20/hour
